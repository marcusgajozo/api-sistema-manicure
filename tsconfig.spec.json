{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "@src/*": ["./src/*"],
      "@test/*": ["./test/*"],
      "@test/e2e/*": ["./test/e2e/src/*", "./test/e2e/*"]
    }
  },
  "include": ["src/**/*.spec.ts", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
