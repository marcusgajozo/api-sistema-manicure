# Ignore everything at root by default
*

# --- Source code ---
!src/**
!docs/**
!.husky/**

# --- Root config files ---
!.gitignore
!.nvmrc
!.prettierrc
!.env.example
!commitlint.config.js
!docker-compose.local.yaml
!Dockerfile
!eslint.config.mjs
!LICENSE
!nest-cli.json
!package.json
!pnpm-lock.yaml
!README.md
!tsconfig.build.json
!tsconfig.json

# --- Re-ignore build artifacts, dependencies, secrets ---
node_modules/
dist/
build/
coverage/
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
*.log
.DS_Store
